# ==============================================================================
# .agent/.env.agent - Secure Credentials for Integrations & Cloud Services
# NOTE: This file is ignored by Git. Do NOT commit real tokens to VCS!
# ==============================================================================

# GITHUB INTEGRATION (Pull Requests, Issues, Releases)
GITHUB_TOKEN=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=

# JIRA CLOUD INTEGRATION (Sprint Boards, Tickets Sync)
JIRA_HOST=https://your-domain.atlassian.net
JIRA_EMAIL=dev@company.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=PROJ

# FIGMA DESIGN INTEGRATION (Inspect UI tokens, assets)
FIGMA_ACCESS_TOKEN=
FIGMA_FILE_KEY=

# CLOUD / DEPLOYMENT (Tùy chọn)
DOCKER_REGISTRY=ghcr.io
DEPLOY_ENVIRONMENT=development

# SUBAGENTS / AUXILIARY AI API KEYS (Nếu sử dụng mô hình phụ trợ)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
